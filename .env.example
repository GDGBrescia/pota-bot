# Copia in pota_bot/.env e inserisci la tua chiave da https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Facoltativo: il modello da usare
# POTA_BOT_MODEL=gemini-3.5-flash-lite

# Per usare il bot su Telegram (scripts/run_polling.py):
# TELEGRAM_BOT_TOKEN=            # il token che ti dà @BotFather
# TELEGRAM_BOT_USERNAME=         # lo username del bot, senza @
# TELEGRAM_DIGEST_CHAT_ID=       # id del gruppo che riceve il digest (numero negativo)
